# PostgreSQL connection string (local Docker default; use your Neon URL in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/nt_agency?schema=public"

# Secret used to sign login tokens: a random string of at least 32 characters
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: Anthropic API key for AI triage and the chatbot.
# Leave empty to use the built-in keyword classifier and FAQ bot.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-5-5)
ANTHROPIC_MODEL=""
